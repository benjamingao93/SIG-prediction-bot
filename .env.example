# Copy to .env and fill in. NEVER commit .env.
SIG_API_KEY=
SIG_BASE_URL=https://www.thesuper.market/api/v1
# Tournament slug from the site URL / `sigbot check`
SIG_TOURNAMENT_SLUG=

# collect | paper | live  (live also requires `sigbot run --live`)
MODE=paper

# Per-process API budgets. The account limit is 100 reads + 30 writes per minute,
# shared across ALL keys and processes. Keep headroom if you also click around the site.
READ_BUDGET=80
WRITE_BUDGET=25

DB_PATH=data/sig.db
INPUTS_PATH=data/inputs.csv
# Fundamentals model: `sigbot races` builds this file from Wikipedia (PVI, incumbents).
RACES_PATH=data/races.csv
# National environment: generic-ballot margin, Democratic-positive (D+8.4 → 8.4). Blank = model off.
# `sigbot races` prints the current Wikipedia average; update this as polls move.
GENERIC_BALLOT_D=
# Weight on the market price vs your outside view (polls / forecast / fundamentals)
MARKET_WEIGHT=0.7
# If this file exists, no new orders are sent.
KILL_SWITCH=KILL

# Risk (SUSQies of cost basis)
MAX_POSITION=5000
MAX_MARKET_EXPOSURE=7500
MAX_GROUP_EXPOSURE=15000
MAX_ORDER_COST=2000
DAILY_LOSS_STOP=10000
KELLY_FRACTION=0.25
MIN_EDGE=0.03
UNCERTAINTY_MULT=1.0

# Arbitrage (`sigbot arb`): buy NO on every party in a race when the YES bids sum above 1
ARB_MIN_PROFIT=0.005
ARB_MAX_SETS=2000
ARB_MAX_CAPITAL=50000
# Sell a held NO basket when the YES asks sum below 1 - ARB_MIN_PROFIT (beats holding to settlement)
ARB_EXIT=true
# YES baskets assume one listed party wins: not riskless. Needs data/races.csv.
ARB_YES_BASKETS=false
ARB_POLL_SECONDS=4
# Skip a trade whose books are older than this by send time (rate-limit waits)
ARB_MAX_BOOK_AGE=2
# Max loss per share accepted when finishing the hedge of an uneven fill
ARB_REPAIR_SLIPPAGE=0.02
