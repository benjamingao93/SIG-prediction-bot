# Copy to .env and fill in. NEVER commit .env.
SIG_API_KEY=
SIG_BASE_URL=https://www.thesuper.market/api/v1
# Tournament slug from the site URL / `sigbot check`
SIG_TOURNAMENT_SLUG=

# collect | paper | live  (live also requires `sigbot run --live`)
MODE=paper

# Per-process API budgets. The account limit is 100 reads + 30 writes per minute,
# shared across ALL keys and processes. Keep headroom if you also click around the site.
READ_BUDGET=80
WRITE_BUDGET=25

DB_PATH=data/sig.db
INPUTS_PATH=data/inputs.csv
# Fundamentals model: `sigbot races` builds this file from Wikipedia (PVI, incumbents).
RACES_PATH=data/races.csv
# National environment: generic-ballot margin, Democratic-positive (D+8.4 → 8.4). Blank = model off.
# `sigbot races` prints the current Wikipedia average; update this as polls move.
GENERIC_BALLOT_D=
# Weight on the market price vs your outside view (polls / forecast / fundamentals)
MARKET_WEIGHT=0.7
# If this file exists, no new orders are sent.
KILL_SWITCH=KILL

# Risk (SUSQies of cost basis)
MAX_POSITION=5000
MAX_MARKET_EXPOSURE=7500
MAX_GROUP_EXPOSURE=15000
MAX_ORDER_COST=2000
DAILY_LOSS_STOP=10000
KELLY_FRACTION=0.25
MIN_EDGE=0.03
UNCERTAINTY_MULT=1.0

# Arbitrage (`sigbot arb`): buy NO on every party in a race when the YES bids sum above 1
ARB_MIN_PROFIT=0.005
ARB_MAX_SETS=2000
# Most that may sit in baskets at once (cost basis, including baskets from earlier runs)
ARB_MAX_CAPITAL=50000
# Sell a held NO basket when the YES asks sum below 1 - ARB_MIN_PROFIT (beats holding to settlement)
ARB_EXIT=true
# ...or as soon as a sale locks in this much per set over what the set cost (false: only beat-holding exits)
ARB_EXIT_EARLY=true
ARB_EXIT_MIN_PROFIT=0.0025
# Realtime feed (`sigbot arb --feed`): markets kept on the WebSocket feed
ARB_FEED_MARKETS=40
# Passive quotes (`sigbot arb --quote`): rest a buy-NO on one party priced so a fill hedged at
# today's prices earns ARB_QUOTE_EDGE per set. Size = the most a race can be one-sided.
ARB_QUOTE_RACES=3
ARB_QUOTE_SIZE=200
ARB_QUOTE_EDGE=0.005
ARB_QUOTE_TTL=180
ARB_QUOTE_MIN_LIFE=20
# YES baskets assume one listed party wins: not riskless. Needs data/races.csv.
ARB_YES_BASKETS=false
ARB_POLL_SECONDS=4
# Skip a trade whose books are older than this by send time (rate-limit waits)
ARB_MAX_BOOK_AGE=2
# Seconds an order may wait at the exchange before expiring unexecuted. Short = fewer one-sided fills
ARB_ORDER_TTL=15
# Use at most this share of each shown book level, so every leg still fills if others trade first
ARB_DEPTH_FRACTION=0.5
# Max loss per share accepted when finishing the hedge of an uneven fill
ARB_REPAIR_SLIPPAGE=0.02

# Fair value from Kalshi + forecaster ratings (`sigbot edges`), and directional limits (later phases)
DIR_KALSHI_WEIGHT=0.7
DIR_MAX_KALSHI_SPREAD=0.04
DIR_MIN_KALSHI_OI=1000
DIR_MAX_OTHER=0.05
DIR_MIN_RATERS=3
DIR_MIN_EDGE=0.02
DIR_REQUIRE_AGREEMENT=true
DIR_OFFICES=senate,governor
DIR_BUDGET=20000
DIR_MAX_RACE=2000
# The arb bot tracks fair values + edge history (Kalshi every 5 min, history every 10 min)
DIR_TRACK=true
DIR_KALSHI_REFRESH=300
DIR_HISTORY_EVERY=600
# Directional trader (`sigbot arb --directional`): live starts small
DIR_LIVE_BUDGET=5000
DIR_LIVE_MAX_RACE=500
DIR_KELLY_FRACTION=0.25
DIR_MAX_NET=8000
DIR_LOSS_STOP=2000
DIR_TAKE_HALF_AT=0.5
DIR_EXIT_BAND=0.005
DIR_STOP=0.03
